# 数据库配置
DB_DSN="platform:platform123@tcp(mysql:3306)/gpu_platform?charset=utf8mb4&parseTime=True&loc=Local"

# 服务端口
PORT=8080

# 用户端口配置
# 默认端口前缀，用户端口将在此基础上分配
# 例如：10000 表示用户端口从10000开始分配
DEFAULT_PORT_PREFIX=10000
# 用户端口分配步长（每个用户占用的端口数量）
# 例如：10 表示第一个用户使用10000-10009，第二个用户使用10010-10019
# 端口分配：0=SSH, 1=VSCode, 2=Jupyter, 3-9=备用应用
PORT_STEP=10

# 数据根目录配置（简化配置）
# 只需要配置一个数据根目录，其他目录会自动生成
# 例如：/root/work/ai4s/data 或 /opt/ai4s/data
DATA_ROOT="${PWD}/data"

# Pip源配置（可选，用于加速Python包安装）
# 取消注释以下行来使用清华大学镜像源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# PIP_TIMEOUT=60

# 内网Pip源配置示例（企业内网环境）
# PIP_INDEX_URL=http://your-internal-pypi.company.com/simple/
# PIP_TRUSTED_HOST=your-internal-pypi.company.com
# PIP_TIMEOUT=60
